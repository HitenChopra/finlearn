# Required for REAL email ownership verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FinLearn <your-email@gmail.com>

# Change this to a long random value
AUTH_CODE_SALT=change-this-to-a-long-random-string

# Development helpers
DEV_SHOW_EMAIL_CODE=true
SKIP_MX_CHECK=false
